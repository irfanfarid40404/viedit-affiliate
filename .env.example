# Google Gemini / Vertex AI Express API Key
GEMINI_API_KEY=

# Vertex AI Express Token / Key (format: AQ.Ab8...)
VERTEX_API_KEY=

# 9Router (OpenAI-compatible aggregator)
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
NINEROUTER_MODEL=

# Pixazo (https://pixazo.ai) — video generation, uses wallet balance
PIXAZO_API_KEY=

# Magic Hour (https://magichour.ai) — video generation, uses credits
MAGICHOUR_API_KEY=

# OpenRouter API Key
OPENROUTER_API_KEY=

# Backend server port
PORT=5001

# Path to system FFmpeg binary
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
